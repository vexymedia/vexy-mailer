# ---------------------------------------------------------------------------
# vexy-mailer
#
# Copy to .env.local for development, or paste into Vercel's environment
# variables for production. Every value here is required unless marked
# optional. See README.md for how to obtain each one.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string.
#
# Use the *Transaction pooler* string (port 6543) for Vercel: serverless
# functions open many short-lived connections and would exhaust the direct
# connection limit. The app detects port 6543 and disables prepared statements
# automatically, as PgBouncer's transaction mode requires.
#
# For a local Postgres, append ?sslmode=disable.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Maximum pooled connections held by one serverless instance. Optional.
# DB_POOL_MAX=5

# --- Secrets ---------------------------------------------------------------
# Encrypts mailbox passwords at rest (AES-256-GCM). Must decode to exactly
# 32 bytes. Generate with:  openssl rand -base64 32
#
# WARNING: changing this makes every stored mailbox password undecryptable.
# You would have to re-enter them.
ENCRYPTION_KEY="paste-32-bytes-of-base64-here"

# Signs the login session cookie, and the unsubscribe links in your emails.
# Generate with:  openssl rand -hex 32
SESSION_SECRET="paste-a-long-random-string-here"

# The password you type to sign in. There is one user: you.
APP_PASSWORD="choose-a-strong-password"

# Authorises the worker endpoint (/api/cron/tick). Vercel Cron sends this
# automatically as a Bearer token when the variable is named CRON_SECRET.
# Generate with:  openssl rand -hex 32
CRON_SECRET="paste-a-long-random-string-here"

# --- URLs ------------------------------------------------------------------
# Public base URL, used to build unsubscribe links. On Vercel this is inferred
# from VERCEL_PROJECT_PRODUCTION_URL, but setting it explicitly is safer -
# a preview deployment would otherwise mint links pointing at itself.
APP_URL="https://your-app.vercel.app"

# --- Worker tuning (all optional) -------------------------------------------
# Retry attempts for a send that provably did not go out. Never applies to a
# send whose outcome is unknown - those are never retried.
# MAX_SEND_ATTEMPTS=3

# A send still claimed after this long is treated as indeterminate and marked
# `unknown`. Keep it comfortably above your function timeout.
# SEND_CLAIM_TIMEOUT_MS=300000

# How often each mailbox's IMAP inbox is polled for replies.
# REPLY_POLL_INTERVAL_MS=300000

# SMTP timeouts. The socket timeout is the boundary between a failure we can
# retry and one we cannot classify, so do not set it aggressively low.
# SMTP_CONNECTION_TIMEOUT_MS=20000
# SMTP_GREETING_TIMEOUT_MS=20000
# SMTP_SOCKET_TIMEOUT_MS=60000

# --- Tests only ------------------------------------------------------------
# Database used by `npm test`. Its schema is DROPPED and rebuilt on every run,
# so it must never point at anything you care about.
# TEST_DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/vexy_mailer_test?sslmode=disable"
