# ---------------------------------------------------------------------------
# VEXY — proměnné prostředí
#
# Zkopírujte do .env.local pro vývoj, nebo vložte do nastavení hostingu
# (Vercel → Settings → Environment Variables) pro produkci.
#
# Soubor je rozdělený na POVINNÉ a NEPOVINNÉ. Bez povinných se aplikace
# nerozběhne a řekne, která přesně chybí. Bez nepovinných funguje dál, jen
# je příslušná část nedostupná — a proč, je vidět v administraci pod
# Nastavení → Stav systému.
#
# Jsou tu jen proměnné, které kód opravdu čte. Žádné historické.
# ---------------------------------------------------------------------------


# ===========================================================================
# POVINNÉ
# ===========================================================================

# --- Databáze --------------------------------------------------------------
# POZOR: jsou to DVĚ různé adresy k téže databázi. Liší se portem a každá
# je potřeba pro něco jiného. Zaměnit je znamená produkční výpadek —
# přesně ten, kvůli kterému tahle poznámka vznikla.
#
# Supabase → Project Settings → Database → Connection string.

# RUNTIME — Transaction pooler, port 6543.
#
# Tudy chodí běžící aplikace. Transaction režim vrací spojení do poolu po
# každé transakci, takže ho serverless funkce nedrží déle, než musí.
#
# Se SESSION poolerem (port 5432) tady produkce spadla na:
#   PostgresError (EMAXCONNSESSION) max clients reached in session mode
# Session režim drží spojení po celou dobu sezení a strop 15 klientů
# vyčerpá pár souběžných instancí funkce.
#
# Aplikace k tomu drží max 1 spojení na instanci a nepoužívá prepared
# statements — obojí transaction pooler vyžaduje.
DATABASE_URL="postgresql://postgres.xxxxxxxx:HESLO@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# MIGRACE — Session pooler, port 5432. (Přímé spojení funguje taky.)
#
# Tudy chodí `npm run release` a `npm run db:migrate`. Musí to být session
# režim, protože souběžná nasazení se domlouvají přes `pg_advisory_lock()`
# a ten je vázaný na SEZENÍ — v transakčním režimu by se spojení po commitu
# vrátilo do poolu a zámek by nedržel nic.
#
# Migrace běží jednou za nasazení, takže jí strop session režimu nevadí.
# Když proměnná chybí, zkusí se DATABASE_URL (kvůli lokálnímu vývoji,
# kde je to jedna a tatáž přímá adresa); pokud ale i ta vede na port 6543,
# release se schválně zastaví, místo aby migroval bez funkčního zámku.
MIGRATION_DATABASE_URL="postgresql://postgres.xxxxxxxx:HESLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Šifruje hesla ke schránkám v databázi (AES-256-GCM). Musí dekódovat přesně
# na 32 bajtů. Vygenerujete:  openssl rand -base64 32
#
# POZOR: změnou téhle hodnoty se stanou uložená hesla ke schránkám
# nerozšifrovatelnými a bude je nutné zadat znovu.
ENCRYPTION_KEY="sem-32-bajtu-v-base64"

# Podepisuje přihlašovací cookie a odkazy na odhlášení v e-mailech.
# Vygenerujete:  openssl rand -hex 32
SESSION_SECRET="sem-dlouhy-nahodny-retezec"

# Autorizuje worker endpoint /api/cron/tick. Vercel Cron ho posílá sám jako
# Bearer token, právě když se proměnná jmenuje CRON_SECRET.
# Vygenerujete:  openssl rand -hex 32
CRON_SECRET="sem-dlouhy-nahodny-retezec"

# Veřejná adresa aplikace. Staví se z ní odkazy na odhlášení a proti ní se
# ověřují Twilio webhooky.
#
# Na Vercelu se dá odvodit z VERCEL_PROJECT_PRODUCTION_URL, ale nastavit ji
# napevno je bezpečnější: preview nasazení by jinak generovalo odkazy na
# odhlášení mířící samo na sebe.
APP_URL="https://vase-aplikace.vercel.app"


# ===========================================================================
# NEPOVINNÉ — volání z prohlížeče (Twilio)
#
# Bez nich funguje celá e-mailová část. Tlačítko Zavolat zůstane, ale po
# kliknutí rovnou řekne, co na serveru chybí — hovor se nikam „tiše"
# nepřepošle. Podrobný postup v docs/calling.md.
# ===========================================================================

# Twilio Console → Account Info
# TWILIO_ACCOUNT_SID="AC..."

# Heslo k celému účtu. Ověřuje podpisy webhooků a stahuje nahrávky.
# Nikdy nesmí do prohlížeče ani do repozitáře.
# TWILIO_AUTH_TOKEN="..."

# Twilio Console → Account → API keys & tokens → Create API key (Standard).
# Tímhle klíčem se podepisuje krátkodobý token pro prohlížeč; při úniku ho
# zneplatníte bez měnění hesla k účtu.
# TWILIO_API_KEY_SID="SK..."
# TWILIO_API_KEY_SECRET="..."

# Twilio Console → Voice → TwiML → TwiML Apps.
# Voice Request URL musí být https://VASE-DOMENA/api/calling/voice (POST).
# TWILIO_TWIML_APP_SID="AP..."

# Číslo, které uvidí volaný. Musí patřit vašemu Twilio účtu.
# TWILIO_CALLER_ID="+420..."

# Veřejná adresa, proti které se ověřuje podpis webhooků. Když chybí, použije
# se APP_URL. Při lokálním vývoji sem patří adresa tunelu.
# TWILIO_WEBHOOK_BASE_URL="https://vexy.example.com"


# ===========================================================================
# NEPOVINNÉ — přepis a analýza hovorů (OpenAI)
#
# Bez klíče se volá normálně, jen z hovoru nevznikne přepis ani shrnutí.
# Hovory počkají ve frontě a zpracují se, jakmile klíč doplníte.
# ===========================================================================

# OPENAI_API_KEY="sk-..."
# OPENAI_TRANSCRIBE_MODEL="whisper-1"
# OPENAI_ANALYSIS_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"


# ===========================================================================
# NEPOVINNÉ — ladění výkonu
#
# Výchozí hodnoty jsou rozumné. Měňte jen když víte proč.
# ===========================================================================

# Kolik spojení drží jedna instance aplikace. Výchozí 1, protože tohle běží
# serverless a pool se násobí počtem živých instancí, ne jednou.
#
# Zvyšovat jen na nasazení do jednoho dlouhoběžícího procesu (vlastní
# server, kontejner). Na Vercelu tohle NENASTAVUJTE.
# DB_POOL_MAX=1

# Kolik pokusů dostane odeslání, které PROKAZATELNĚ neodešlo. Nikdy se
# nevztahuje na odeslání s neznámým výsledkem — ta se neopakují nikdy.
# MAX_SEND_ATTEMPTS=3

# Po téhle době se zaseknuté odeslání považuje za nejisté a označí se
# `unknown`. Držte to pohodlně nad časovým limitem funkce.
# SEND_CLAIM_TIMEOUT_MS=300000

# Jak často se u každé schránky kouká do IMAPu na odpovědi.
# REPLY_POLL_INTERVAL_MS=300000

# Timeouty SMTP. Socket timeout je hranice mezi selháním, které jde
# zopakovat, a selháním, které zařadit neumíme — nenastavujte ho agresivně
# nízko.
# SMTP_CONNECTION_TIMEOUT_MS=20000
# SMTP_GREETING_TIMEOUT_MS=20000
# SMTP_SOCKET_TIMEOUT_MS=60000


# ===========================================================================
# JEN PRO TESTY
# ===========================================================================

# Databáze, proti které běží `npm test`. Její schéma se při každém běhu
# ZAHODÍ a postaví znovu, takže nesmí ukazovat na nic, o co stojíte.
# TEST_DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/vexy_mailer_test?sslmode=disable"
